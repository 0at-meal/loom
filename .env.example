# Loom Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO
# Redis Configuration (Data Layer)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# SQLite Configuration (Append-only Metrics Log)
SQLITE_DB_PATH=loom_metrics.db
# Router Parameters (Defaults)
DECAY_HALF_LIFE_SEC=60.0
PID_KP=1.0
PID_KI=0.1
PID_KD=0.05
