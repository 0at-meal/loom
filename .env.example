# ==============================================================================
# Loom Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local development:
#   cp .env.example .env

# General Runtime Environment
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Redis Data Layer Configuration (Phase 5 Ticket A & B)
# ------------------------------------------------------------------------------
# Served router: publish events and belief snapshots to Redis (off by default; --redis).
REDIS_ENABLED=false
REDIS_SNAPSHOT_INTERVAL_SEC=5.0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
REDIS_TIMEOUT_SEC=2.0
REDIS_MAX_CONNECTIONS=50

# Redis Namespacing & Pub/Sub Channels
KEY_PREFIX=
REDIS_CHANNEL_ROUTING=events:routing
REDIS_CHANNEL_HEALTH=events:health

# ------------------------------------------------------------------------------
# SQLite Append-Only Metrics Ledger Configuration (Phase 5 Ticket C)
# ------------------------------------------------------------------------------
# Served router: log every decision to this SQLite ledger (on by default; --no-ledger).
LEDGER_ENABLED=true
SQLITE_DB_PATH=loom_metrics.db
SQLITE_BATCH_SIZE=20
SQLITE_FLUSH_INTERVAL_SEC=0.05
SQLITE_MAX_QUEUE_SIZE=10000

# ------------------------------------------------------------------------------
# Routing Core & PID Controller Tuning Parameters (Phases 1-4 Defaults)
# ------------------------------------------------------------------------------
# Seconds for a bandit observation's weight to halve (read by router_core.server).
DECAY_HALF_LIFE_SEC=2.3
# Most payments dispatched at once; extra requests wait for a slot (0 = no limit).
ROUTER_MAX_IN_FLIGHT=50
PID_KP=1.0
PID_KI=0.1
PID_KD=0.05
